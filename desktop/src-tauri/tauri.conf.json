{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMAIC",
  "version": "1.0.3",
  "identifier": "chat.maic.openmaic",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenMAIC",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../resources/": ""
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
